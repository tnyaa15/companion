# --- Telegram ---
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message @userinfobot to get it).
# The bot ignores everyone else.
OWNER_TELEGRAM_ID=

# --- LLM (any OpenAI-compatible provider) ---
# Groq example (free tier, fast):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Gemini example (free tier, OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
# Free tiers change limits and retire model names often. If you get a 404 or
# a rate-limit error, check the provider's current model list and update LLM_MODEL.

# --- Personality / schedule ---
PERSONA_NAME=Nova
USER_NAME=friend
TIMEZONE=Asia/Kolkata
MORNING_HOUR=8
MORNING_MINUTE=5
# No proactive messages between these hours (overnight ranges work)
QUIET_START=23
QUIET_END=8
MAX_PROACTIVE_PER_DAY=3
HISTORY_TURNS=30
DB_PATH=companion.db
