# --- Telegram ---
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message @userinfobot to get it).
# The bot ignores everyone else.
OWNER_TELEGRAM_ID=

# --- LLM provider ---
# Use groq, openai, gemini, or anthropic. Set the API key and model for it.
# Groq example (free tier, fast):
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Optional endpoint override for an OpenAI-compatible provider.
# Gemini API endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# Free tiers change limits and retire model names often. If you get a 404 or
# a rate-limit error, check the provider's current model list and update LLM_MODEL.

# --- Personality / proactive boundaries ---
PERSONA_NAME=Nova
USER_NAME=Tanyaa
TIMEZONE=Asia/Kolkata
# Context-aware check-ins respect these quiet hours (overnight ranges work).
QUIET_START=23
QUIET_END=8
MAX_PROACTIVE_PER_DAY=3
PROACTIVE_CHANNEL=telegram
HISTORY_TURNS=30
DB_PATH=companion.db

# --- Google Calendar (OAuth client file is local and never committed) ---
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_FILE=google-calendar-token.json
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json

# --- Discord (optional) ---
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
# Optional: server text-channel ID for proactive check-ins and reminders.
# Leave blank to receive proactive messages in a private DM.
DISCORD_CHANNEL_ID=
